<!DOCTYPE html>
<html>

<head>

<title>Search</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet">

<link rel="stylesheet" href="/style.css">

</head>

<body>

<%- include('partials_nav') %>

<div class="container mt-4">

<h1>Search Clothing</h1>

<form action="/search" method="GET">

<input
type="text"
name="keyword"
class="form-control mb-3"
placeholder="Enter clothing name"
>

<button
type="submit"
class="btn btn-dark"
>

Search

</button>

</form>

<hr>

<div class="row">

<% results.forEach(item=>{ %>

<div class="col-md-4">

<div class="card mb-4">

<img
src="<%= item.imageUrl %>"
class="card-img-top"
style="height:180px; object-fit:cover;"
>

<div class="card-body">

<h5>
<%= item.name %>
</h5>

<p>
Category: <%= item.category %>
</p>

<p>
Style: <%= item.style %>
</p>

<p>
Brand: <%= item.brand %>
</p>

</div>

</div>

</div>

<% }) %>

</div>

</div>

</body>

</html>