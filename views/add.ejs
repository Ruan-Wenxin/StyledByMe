<!DOCTYPE html>
<html>

<head>

<title>Add Item</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet">

<link rel="stylesheet" href="/style.css">

</head>

<body>

<%- include('partials_nav') %>

<div class="container mt-4">

<h1>Add New Item</h1>

<form action="/add" method="POST">

<label class="form-label mt-3">
Image URL
</label>

<input
type="text"
name="imageUrl"
class="form-control"
required
>

<label class="form-label mt-3">
Name
</label>

<input
type="text"
name="name"
class="form-control"
required
>

<label class="form-label mt-3">
Category
</label>

<select
name="category"
class="form-select"
>

<option>Top</option>
<option>Bottom</option>
<option>Outerwear</option>
<option>Shoes</option>

</select>

<label class="form-label mt-3">
Color
</label>

<input
type="text"
name="color"
class="form-control"
required
>

<label class="form-label mt-3">
Style
</label>

<select
name="style"
class="form-select"
>

<option>Casual</option>
<option>Streetwear</option>
<option>Formal</option>

</select>

<button
type="submit"
class="btn btn-dark mt-4"
>

Submit

</button>

</form>

</div>

</body>

</html>