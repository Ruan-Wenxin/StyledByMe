<!DOCTYPE html>
<html>

<head>

<title>View Details</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet">

<link rel="stylesheet" href="/styled.css">

</head>

<body>

<%- include('partials_nav') %>

<div class="container mt-4">

<h1>

Clothing Details

</h1>

<img
src="<%= item.imageUrl %>"
style="width:400px"
class="mb-4"
>

<p>

<strong>Name:</strong>

<%= item.name %>

</p>

<p>

<strong>Category:</strong>

<%= item.category %>

</p>

<p>

<strong>Color:</strong>

<%= item.color %>

</p>

<p>

<strong>Style:</strong>

<%= item.style %>

</p>

<a
href="/closet"
class="btn btn-dark"
>

Back

</a>

</div>

</body>

</html>