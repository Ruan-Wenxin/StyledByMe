<!DOCTYPE html>
<html>

<head>

<title>Item Added</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet">

<link rel="stylesheet" href="/style.css">

</head>

<body>

<%- include('partials_nav') %>

<div class="container mt-5">

<div class="text-center">

<h1>

Item Added Successfully

</h1>

<img
src="<%= item.imageUrl %>"
style="width:300px"
>

<p class="mt-3">

<strong>Name:</strong>

<%= item.name %>

</p>

<p>

<strong>Category:</strong>

<%= item.category %>

</p>

<a
href="/closet"
class="btn btn-dark"
>

Back To Closet

</a>

</div>

</div>

</body>

</html>