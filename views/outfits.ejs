<!DOCTYPE html>
<html>

<head>

<title>My Outfits</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet">

<link rel="stylesheet" href="/style.css">

</head>

<body>

<%- include('partials_nav') %>

<div class="container mt-4">

<h1>My Favourite Outfits</h1>

<div class="row">

<% favorites.forEach(item=>{ %>

<div class="col-md-4">

<div class="card mb-4">

<img
src="<%= item.imageUrl %>"
class="card-img-top"
>

<div class="card-body">

<h5>
<%= item.name %>
</h5>

<p>
<%= item.brand %>
</p>

</div>

</div>

</div>

<% }) %>

</div>

</div>

</body>

</html>